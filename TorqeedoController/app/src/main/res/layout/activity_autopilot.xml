<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/bg_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AUTO-PILOT"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Heading Status Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/bg_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CURRENT HEADING"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:letterSpacing="0.1" />

                    <TextView
                        android:id="@+id/tvCurrentHeading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="000.0°"
                        android:textColor="@color/accent_primary"
                        android:textSize="48sp"
                        android:fontFamily="sans-serif-medium" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginTop="8dp">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:id="@+id/tvMagHeading"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="000.0°"
                                android:textColor="@color/text_primary"
                                android:textSize="48sp"
                                android:fontFamily="sans-serif-medium" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="MAG"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <View android:layout_width="1dp" android:layout_height="match_parent"
                            android:background="@color/border_subtle" android:layout_marginHorizontal="8dp"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:id="@+id/tvGpsCourse"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="000.0°"
                                android:textColor="@color/text_primary"
                                android:textSize="48sp"
                                android:fontFamily="sans-serif-medium" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="COG"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/border_subtle"
                        android:layout_marginVertical="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TARGET HEADING"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:letterSpacing="0.1" />

                    <TextView
                        android:id="@+id/tvTargetHeading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="000.0°"
                        android:textColor="@color/status_connected"
                        android:textSize="48sp"
                        android:fontFamily="sans-serif-medium" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/border_subtle"
                        android:layout_marginVertical="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SEA STATE: "
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:letterSpacing="0.1" />

                        <TextView
                            android:id="@+id/tvSeaState"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CALM"
                            android:textColor="@color/status_connected"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvPitchRoll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="P: 0.0° R: 0.0°"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Navigation Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/bg_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NAVIGATION"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"
                        android:letterSpacing="0.1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenMap"
                        style="@style/Widget.TorqeedoController.Button.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:text="OPEN MAP PICKER"
                        app:icon="@android:drawable/ic_dialog_map"
                        app:iconGravity="textStart" />

                    <TextView
                        android:id="@+id/tvWaypointInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No target set"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:layout_marginTop="12dp"
                        android:gravity="center"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Heading Adjustment Controls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="24dp">

                <Button
                    android:id="@+id/btnHdgMinus10"
                    style="@style/Widget.TorqeedoController.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:text="-10°"
                    android:layout_marginEnd="4dp"/>

                <Button
                    android:id="@+id/btnHdgMinus1"
                    style="@style/Widget.TorqeedoController.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:text="-1°"
                    android:layout_marginEnd="8dp"/>

                <Button
                    android:id="@+id/btnHdgPlus1"
                    style="@style/Widget.TorqeedoController.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:text="+1°"
                    android:layout_marginStart="8dp"/>

                <Button
                    android:id="@+id/btnHdgPlus10"
                    style="@style/Widget.TorqeedoController.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:text="+10°"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>

            <!-- Auto-Pilot Toggle -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleAutoPilot"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:text="ENGAGE AUTO-PILOT"
                android:textSize="18sp"
                app:cornerRadius="40dp"
                android:layout_marginBottom="24dp"
                android:backgroundTint="@color/status_connected" />

            <!-- PID Tuning Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/bg_surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="PID TUNING"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp"
                            android:letterSpacing="0.1" />
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/swUseRudderSensor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="USE 0xA5 SENSOR"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- Kp -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:text="Kp"
                            android:textColor="@color/text_primary" />
                        <SeekBar
                            android:id="@+id/sbKp"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="100" />
                        <EditText
                            android:id="@+id/etKp"
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:gravity="center"
                            android:textSize="14sp"
                            android:background="@color/bg_primary"
                            android:padding="4dp"
                            android:imeOptions="actionDone" />
                    </LinearLayout>

                    <!-- Ki -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:text="Ki"
                            android:textColor="@color/text_primary" />
                        <SeekBar
                            android:id="@+id/sbKi"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="100" />
                        <EditText
                            android:id="@+id/etKi"
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:gravity="center"
                            android:textSize="14sp"
                            android:background="@color/bg_primary"
                            android:padding="4dp"
                            android:imeOptions="actionDone" />
                    </LinearLayout>

                    <!-- Kd -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:text="Kd"
                            android:textColor="@color/text_primary" />
                        <SeekBar
                            android:id="@+id/sbKd"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="100" />
                        <EditText
                            android:id="@+id/etKd"
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:gravity="center"
                            android:textSize="14sp"
                            android:background="@color/bg_primary"
                            android:padding="4dp"
                            android:imeOptions="actionDone" />
                    </LinearLayout>

                    <!-- Deadband -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:text="Db"
                            android:textColor="@color/text_primary" />
                        <SeekBar
                            android:id="@+id/sbDeadband"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="100" />
                        <EditText
                            android:id="@+id/etDeadband"
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:gravity="center"
                            android:textSize="14sp"
                            android:background="@color/bg_primary"
                            android:padding="4dp"
                            android:imeOptions="actionDone" />
                    </LinearLayout>

                    <!-- Max Turn Rate (Rate Limit) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:text="Rate"
                            android:textColor="@color/text_primary" />
                        <SeekBar
                            android:id="@+id/sbMaxRate"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="100" />
                        <EditText
                            android:id="@+id/etMaxRate"
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:gravity="center"
                            android:textSize="14sp"
                            android:background="@color/bg_primary"
                            android:padding="4dp"
                            android:imeOptions="actionDone" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Rudder & Speed Summary Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/bg_surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:baselineAligned="false">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView
                            android:id="@+id/tvRudderPos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0%"
                            android:textColor="@color/accent_primary"
                            android:textSize="20sp"
                            android:fontFamily="sans-serif-medium" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="RUDDER"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/border_subtle" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView
                            android:id="@+id/tvSpeed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0%"
                            android:textColor="@color/accent_primary"
                            android:textSize="20sp"
                            android:fontFamily="sans-serif-medium" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="THROTTLE"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
