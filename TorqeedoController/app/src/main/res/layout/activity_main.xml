<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <!-- STATUS BAR -->
    <LinearLayout
        android:id="@+id/statusBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/bg_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Torqeedo"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/tvRemoteStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rem: Off"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tvImuStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hdg: Off"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tvGpsStatusTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GPS: Off"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tvConnectionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mot: Off"
            android:textColor="@color/status_disconnected"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- BOAT PROFILE SELECTION -->
    <LinearLayout
        android:id="@+id/profileSelector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_surface"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/statusBar">

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleBoatProfile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true">

            <Button
                android:id="@+id/btnProfileCL16"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CL16"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnProfileMac25"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mac25"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnProfileToy"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Toy"
                android:textSize="12sp" />

        </com.google.android.material.button.MaterialButtonToggleGroup>
    </LinearLayout>

    <!-- DEBUG SETTINGS -->
    <LinearLayout
        android:id="@+id/debugSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_surface"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="4dp"
        app:layout_constraintTop_toBottomOf="@id/profileSelector">

        <!-- Row 1: Raw, Log, Slave -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_raw"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:layout_marginEnd="2dp"/>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchShowRaw"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                app:switchMinWidth="32dp" />

            <View android:layout_width="16dp" android:layout_height="match_parent"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_log"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:layout_marginEnd="2dp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchLogging"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                app:switchMinWidth="32dp" />

            <View android:layout_width="16dp" android:layout_height="match_parent"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Slave"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:layout_marginEnd="2dp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchSlaveMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                app:switchMinWidth="32dp" />
        </LinearLayout>

        <!-- Row 2: Others (LPF, Voice, Motor Status) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LPF"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:layout_marginEnd="2dp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchQmcLpf"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                app:switchMinWidth="32dp" />

            <View android:layout_width="16dp" android:layout_height="match_parent"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_voice"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:layout_marginEnd="2dp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchVoice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                app:switchMinWidth="32dp" />

            <View android:layout_width="16dp" android:layout_height="match_parent"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_mot_stat"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:layout_marginEnd="2dp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchShowMotorStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                app:switchMinWidth="32dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- SCAN PANEL -->
    <LinearLayout
        android:id="@+id/scanPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="20dp"
        app:layout_constraintTop_toBottomOf="@id/debugSettings"
        app:layout_constraintBottom_toTopOf="@id/controlPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_weight="1">

        <Button
            android:id="@+id/btnScan"
            style="@style/Widget.TorqeedoController.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Scan for Motor"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnScanRemote"
            style="@style/Widget.TorqeedoController.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Scan for Remote"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnScanGps"
            style="@style/Widget.TorqeedoController.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Scan for GPS"
            android:layout_marginBottom="8dp" />

<!--        <Button-->
<!--            android:id="@+id/btnScanImu"-->
<!--            style="@style/Widget.TorqeedoController.Button.Secondary"-->
<!--            android:layout_width="match_parent"-->
<!--            android:layout_height="48dp"-->
<!--            android:text="Scan for Heading"-->
<!--            android:layout_marginBottom="16dp" />-->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Scan for all BLE devices"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchScanAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/scanProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvNoDevices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No devices found."
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDevices"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingVertical="4dp" />
    </LinearLayout>

    <!-- CONTROL PANEL -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/controlPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/scanPanel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- MOTOR DATA Card (Battery, Power, etc.) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/motorDataCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="@color/bg_surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MOTOR STATUS"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false">

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                            <TextView android:id="@+id/tvMotorSoc"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="0%" android:textColor="@color/accent_primary"
                                android:textSize="20sp" android:fontFamily="sans-serif-medium" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="BATT" android:textColor="@color/text_secondary" android:textSize="9sp" />
                        </LinearLayout>

                        <View android:layout_width="1dp" android:layout_height="match_parent"
                            android:background="@color/border_subtle" android:layout_marginVertical="2dp"/>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                            <TextView android:id="@+id/tvMotorWatts"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="0" android:textColor="@color/accent_primary"
                                android:textSize="20sp" android:fontFamily="sans-serif-medium" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="WATTS" android:textColor="@color/text_secondary" android:textSize="9sp" />
                        </LinearLayout>

                        <View android:layout_width="1dp" android:layout_height="match_parent"
                            android:background="@color/border_subtle" android:layout_marginVertical="2dp"/>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                            <TextView android:id="@+id/tvMotorVolts"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="0.0V" android:textColor="@color/accent_primary"
                                android:textSize="20sp" android:fontFamily="sans-serif-medium" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="VOLTS" android:textColor="@color/text_secondary" android:textSize="9sp" />
                        </LinearLayout>

                        <View android:layout_width="1dp" android:layout_height="match_parent"
                            android:background="@color/border_subtle" android:layout_marginVertical="2dp"/>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                            <TextView android:id="@+id/tvMotorRpm"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="0" android:textColor="@color/accent_primary"
                                android:textSize="20sp" android:fontFamily="sans-serif-medium" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="RPM" android:textColor="@color/text_secondary" android:textSize="9sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- TELEMETRY card (GPS + SENSORS) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/telemetryCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="@color/bg_surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GPS TELEMETRY"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp"
                        android:baselineAligned="false">

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                            <TextView android:id="@+id/tvGpsSpeed"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="0.0" android:textColor="@color/accent_primary"
                                android:textSize="18sp" android:fontFamily="sans-serif-medium" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="KNOTS" android:textColor="@color/text_secondary" android:textSize="9sp" />
                        </LinearLayout>

                        <View android:layout_width="1dp" android:layout_height="match_parent"
                            android:background="@color/border_subtle" android:layout_marginVertical="2dp"/>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                            <TextView android:id="@+id/tvGpsCourse"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="—" android:textColor="@color/accent_primary"
                                android:textSize="18sp" android:fontFamily="sans-serif-medium" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="COURSE" android:textColor="@color/text_secondary" android:textSize="9sp" />
                        </LinearLayout>

                        <View android:layout_width="1dp" android:layout_height="match_parent"
                            android:background="@color/border_subtle" android:layout_marginVertical="2dp"/>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                            <TextView android:id="@+id/tvCurrent"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="0.0" android:textColor="@color/accent_primary"
                                android:textSize="18sp" android:fontFamily="sans-serif-medium" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="AMPS" android:textColor="@color/text_secondary" android:textSize="9sp" />
                        </LinearLayout>

                        <View android:layout_width="1dp" android:layout_height="match_parent"
                            android:background="@color/border_subtle" android:layout_marginVertical="2dp"/>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                            <TextView android:id="@+id/tvPower"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="0" android:textColor="@color/accent_primary"
                                android:textSize="18sp" android:fontFamily="sans-serif-medium" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="WATTS" android:textColor="@color/text_secondary" android:textSize="9sp" />
                        </LinearLayout>

                        <View android:layout_width="1dp" android:layout_height="match_parent"
                            android:background="@color/border_subtle" android:layout_marginVertical="2dp"/>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                            <TextView android:id="@+id/tvSteer"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="—" android:textColor="@color/accent_primary"
                                android:textSize="18sp" android:fontFamily="sans-serif-medium" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="STEER" android:textColor="@color/text_secondary" android:textSize="9sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvGpsStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Waiting for GPS fix…"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"
                        android:gravity="center" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/IMUCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="@color/bg_surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HEADING / ATTITUDE"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                            <TextView android:id="@+id/tvFusedHeading"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="0.0°" android:textColor="@color/accent_primary"
                                android:textSize="16sp" android:fontFamily="sans-serif-medium" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="FUSED" android:textColor="@color/text_secondary" android:textSize="9sp" />
                        </LinearLayout>

                        <View android:layout_width="1dp" android:layout_height="match_parent"
                            android:background="@color/border_subtle" android:layout_marginVertical="2dp"/>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                            <TextView android:id="@+id/tvMagHeading"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="0.0°" android:textColor="@color/accent_primary"
                                android:textSize="16sp" android:fontFamily="sans-serif-medium" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="MAG" android:textColor="@color/text_secondary" android:textSize="9sp" />
                        </LinearLayout>

                        <View android:layout_width="1dp" android:layout_height="match_parent"
                            android:background="@color/border_subtle" android:layout_marginVertical="2dp"/>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                            <TextView android:id="@+id/tvTrueHeading"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="0.0°" android:textColor="@color/accent_primary"
                                android:textSize="16sp" android:fontFamily="sans-serif-medium" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="TRUE HDG" android:textColor="@color/text_secondary" android:textSize="9sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/border_subtle" android:layout_marginVertical="6dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                            <TextView android:id="@+id/tvYaw"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="0.0°" android:textColor="@color/accent_primary"
                                android:textSize="16sp" android:fontFamily="sans-serif-medium" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="YAW" android:textColor="@color/text_secondary" android:textSize="9sp" />
                        </LinearLayout>

                        <View android:layout_width="1dp" android:layout_height="match_parent"
                            android:background="@color/border_subtle" android:layout_marginVertical="2dp"/>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                            <TextView android:id="@+id/tvPitch"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="0.0°" android:textColor="@color/accent_primary"
                                android:textSize="16sp" android:fontFamily="sans-serif-medium" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="PITCH" android:textColor="@color/text_secondary" android:textSize="9sp" />
                        </LinearLayout>

                        <View android:layout_width="1dp" android:layout_height="match_parent"
                            android:background="@color/border_subtle" android:layout_marginVertical="2dp"/>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                            <TextView android:id="@+id/tvRoll"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="0.0°" android:textColor="@color/accent_primary"
                                android:textSize="16sp" android:fontFamily="sans-serif-medium" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="ROLL" android:textColor="@color/text_secondary" android:textSize="9sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Main Control Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/motorControlCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="@color/bg_surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:baselineAligned="false">

                        <!-- Speed adjustment (Vertical) -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:gravity="center">

                            <Button
                                android:id="@+id/btnSpeedUp"
                                style="@style/Widget.TorqeedoController.Button.Step"
                                android:layout_width="match_parent"
                                android:layout_height="100dp"
                                android:text="+"
                                android:textSize="48sp" />

                            <TextView
                                android:id="@+id/tvSpeed"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="0%" android:textColor="@color/text_primary"
                                android:textSize="28sp" android:fontFamily="sans-serif-medium"
                                android:layout_marginVertical="8dp" />

                            <Button
                                android:id="@+id/btnSpeedDown"
                                style="@style/Widget.TorqeedoController.Button.Step"
                                android:layout_width="match_parent"
                                android:layout_height="100dp"
                                android:text="−"
                                android:textSize="48sp" />
                        </LinearLayout>

                        <!-- Direction and Stop -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.8"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:layout_marginStart="16dp">

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/switchDirection"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:scaleX="1.8"
                                android:scaleY="1.8"
                                android:layout_marginBottom="16dp" />

                            <TextView
                                android:id="@+id/tvDirectionLabel"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="FORWARD"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:layout_marginBottom="24dp"
                                android:fontFamily="sans-serif-medium" />

                            <Button
                                android:id="@+id/btnStop"
                                style="@style/Widget.TorqeedoController.Button.Stop"
                                android:layout_width="match_parent"
                                android:layout_height="72dp"
                                android:text="STOP"
                                android:textSize="18sp" />

                            <Button
                                android:id="@+id/btnResetSteer"
                                style="@style/Widget.TorqeedoController.Button.Secondary"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_marginTop="12dp"
                                android:text="RESET"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Steering Controls Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/steeringCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="@color/bg_surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="STEERING"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp"
                            android:letterSpacing="0.1" />

                        <TextView
                            android:id="@+id/tvSteerAngle"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Steer Angle: —"
                            android:textColor="@color/accent_primary"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <Button
                            android:id="@+id/btnSteerL5"
                            style="@style/Widget.TorqeedoController.Button.Secondary"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="L 5"
                            android:textSize="11sp"
                            android:layout_marginEnd="4dp"/>

                        <Button
                            android:id="@+id/btnSteerL1"
                            style="@style/Widget.TorqeedoController.Button.Secondary"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="L 1"
                            android:textSize="11sp"
                            android:layout_marginEnd="8dp"/>

                        <TextView
                            android:id="@+id/tvSteerValue"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/accent_primary"
                            android:textSize="22sp"
                            android:fontFamily="sans-serif-medium"
                            android:minWidth="50dp"
                            android:gravity="center" />

                        <Button
                            android:id="@+id/btnSteerR1"
                            style="@style/Widget.TorqeedoController.Button.Secondary"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="R 1"
                            android:textSize="11sp"
                            android:layout_marginStart="8dp"/>

                        <Button
                            android:id="@+id/btnSteerR5"
                            style="@style/Widget.TorqeedoController.Button.Secondary"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="R 5"
                            android:textSize="11sp"
                            android:layout_marginStart="4dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="16dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Runtime Scale (ms)"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/etSteerScale"
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:text="10"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:inputType="number"
                            android:gravity="center"
                            android:background="@color/bg_primary"
                            android:padding="4dp"
                            android:layout_marginEnd="8dp"
                            android:imeOptions="actionDone"/>

                        <SeekBar
                            android:id="@+id/seekBarSteerScale"
                            android:layout_width="140dp"
                            android:layout_height="wrap_content"
                            android:max="500"
                            android:progress="10" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <Button
                android:id="@+id/btnAutoPilot"
                style="@style/Widget.TorqeedoController.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:text="AUTO-PILOT"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnCalibrate"
                style="@style/Widget.TorqeedoController.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="CALIBRATE SENSORS" />

            <Button
                android:id="@+id/btnDisconnect"
                style="@style/Widget.TorqeedoController.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="16dp"
                android:text="Disconnect" />

            <!-- Raw Data Footer -->
            <TextView
                android:id="@+id/tvRawData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Raw: —"
                android:textColor="@color/text_secondary"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:layout_marginTop="12dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
