<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <!-- TOP BAR -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/bg_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            app:tint="@color/text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Calibration"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- SensorFusion 0xA1 Calibration Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/bg_surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0xA1 HEADING FUSION CALIBRATION"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="12dp" />

                    <!-- Live Heading Data -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="FUSED HEADING"
                                android:textColor="@color/text_secondary"
                                android:textSize="10sp" />
                            <TextView
                                android:id="@+id/tvFusedHeading"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="---.-°"
                                android:textColor="@color/accent_primary"
                                android:textSize="18sp"
                                android:fontFamily="sans-serif-medium" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="MAG HEADING"
                                android:textColor="@color/text_secondary"
                                android:textSize="10sp" />
                            <TextView
                                android:id="@+id/tvMagHeading"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="---.-°"
                                android:textColor="@color/text_primary"
                                android:textSize="18sp"
                                android:fontFamily="sans-serif-medium" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Raw Mag Data -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Raw Magnetometer"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">
                        <TextView android:id="@+id/tvRawMx" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="MX: 0" android:textColor="@color/text_primary" android:textSize="12sp" />
                        <TextView android:id="@+id/tvRawMy" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="MY: 0" android:textColor="@color/text_primary" android:textSize="12sp" />
                        <TextView android:id="@+id/tvRawMz" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="MZ: 0" android:textColor="@color/text_primary" android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Raw Gyro Data -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Raw Gyroscope"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">
                        <TextView android:id="@+id/tvRawGx" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="GX: 0" android:textColor="@color/text_primary" android:textSize="12sp" />
                        <TextView android:id="@+id/tvRawGy" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="GY: 0" android:textColor="@color/text_primary" android:textSize="12sp" />
                        <TextView android:id="@+id/tvRawGz" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="GZ: 0" android:textColor="@color/text_primary" android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvCalibDegrees"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Turned: 0.0°"
                        android:textColor="@color/accent_primary"
                        android:textSize="20sp"
                        android:gravity="center"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="8dp" />

                    <Button android:id="@+id/btnResetSFDegrees" style="@style/Widget.TorqeedoController.Button.Secondary"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Reset Degrees" android:layout_marginBottom="16dp" />

                    <!-- Magnetometer Calib Buttons -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Magnetometer Hard-Iron (Rotate 360°)"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvMagCalStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Status: Ready"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">
                        <Button android:id="@+id/btnStartSFMag" style="@style/Widget.TorqeedoController.Button.Secondary"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="Start Mag" android:layout_marginEnd="4dp" />
                        <Button android:id="@+id/btnStopSFMag" style="@style/Widget.TorqeedoController.Button.Primary"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="Stop &amp; Save" />
                    </LinearLayout>

                    <!-- Gyro Bias Calib Buttons -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gyroscope Bias (Keep Steady)"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvGyroCalStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Status: Ready"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <Button android:id="@+id/btnStartSFGyro" style="@style/Widget.TorqeedoController.Button.Secondary"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="Start Gyro" android:layout_marginEnd="4dp" />
                        <Button android:id="@+id/btnStopSFGyro" style="@style/Widget.TorqeedoController.Button.Primary"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="Stop &amp; Save" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Rudder Calibration Card (MMC5603 Ellipse) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/bg_surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MAG STEERING POSITION (MMC5603 / QMC6308)"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <TextView android:id="@+id/tvMagX"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="X: 0"
                            android:textColor="@color/text_primary" android:textSize="12sp" />
                        <TextView android:id="@+id/tvMagY"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Y: 0"
                            android:textColor="@color/text_primary" android:textSize="12sp" />
                        <TextView android:id="@+id/tvMagZ"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Z: 0"
                            android:textColor="@color/text_primary" android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvRudderPos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Steering: Not Calibrated"
                        android:textColor="@color/accent_primary"
                        android:textSize="24sp"
                        android:gravity="center"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ellipse Calibration"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"
                        android:layout_marginBottom="4dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">
                        <Button android:id="@+id/btnStartMagEllipse" style="@style/Widget.TorqeedoController.Button.Secondary"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="Start" android:layout_marginEnd="4dp" />
                        <Button android:id="@+id/btnStopMagEllipse" style="@style/Widget.TorqeedoController.Button.Secondary"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="Stop &amp; Fit" android:layout_marginEnd="4dp" />
                        <Button android:id="@+id/btnSaveMagEllipse" style="@style/Widget.TorqeedoController.Button.Primary"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="Save" />
                    </LinearLayout>

                    <Button android:id="@+id/btnClearMagEllipse" style="@style/Widget.TorqeedoController.Button.Secondary"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Clear Ellipse Data" android:layout_marginBottom="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Physical Mapping (Set Rudder then click)"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"
                        android:layout_marginBottom="4dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnCalibPort"
                            style="@style/Widget.TorqeedoController.Button.Secondary"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Port Max"
                            android:layout_marginEnd="4dp" />

                        <Button
                            android:id="@+id/btnCalibZero"
                            style="@style/Widget.TorqeedoController.Button.Secondary"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Zero"
                            android:layout_marginEnd="4dp" />

                        <Button
                            android:id="@+id/btnCalibStbd"
                            style="@style/Widget.TorqeedoController.Button.Secondary"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Stbd Max" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
